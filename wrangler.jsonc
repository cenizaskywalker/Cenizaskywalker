{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceniza-portfolio",
  "account_id": "e58c9b18ae7eb9b75872595ce79c1910",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/realtime"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cenizasdatabase",
      "database_id": "f70502e3-8ca7-4be9-b721-fc9b7a0ee9cb",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ceniza-portfolio-media",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PUBLICATIONS",
        "class_name": "PublicationHub",
      },
      {
        "name": "PASSWORD_HASHER",
        "class_name": "PasswordHasher",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PublicationHub"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PasswordHasher"],
    },
  ],
  "vars": {
    "SESSION_TTL_SECONDS": "604800",
    "MAX_UPLOAD_BYTES": "10485760",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
